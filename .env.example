# Copy to .env and fill in real values. Never commit .env.
# See docs/CREDENTIALS.md for exactly where to obtain / enter each value.
# Platform credentials (Meta, YouTube, TikTok, LinkedIn) live in n8n's own
# credential vault, NOT here — this file is only for local scripts and
# n8n's own runtime config.

# --- n8n runtime (self-hosted) ---
N8N_ENCRYPTION_KEY=          # generate once with: openssl rand -hex 32

# --- OpenAI (Whisper transcription + image generation) ---
OPENAI_API_KEY=

# --- Notion ---
NOTION_API_KEY=
NOTION_CLIENTS_DB_ID=
NOTION_CONTENT_CALENDAR_DB_ID=
NOTION_SOPS_DB_ID=

# --- Apify ---
APIFY_API_TOKEN=
